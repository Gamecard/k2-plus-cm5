# k2-pi-paket: k2-startwaechter – Klipper nach dem Einschalten des Druckers selbst verbinden (FIRMWARE_RESTART über Moonraker)
# VORLAGE: install.sh ersetzt @USER@ @PY@ @TOOLS@ @DIENST@ @MOONRAKER_DIENST@ und aktiviert die Einheit
# (Standard AN, abschaltbar mit --ohne-startwaechter). Nie bei Sicherheitsabschaltung oder laufendem Druck.
# Log: journalctl -u k2-startwaechter
[Unit]
Description=K2 Start-Wächter (FIRMWARE_RESTART bei fehlender MCU-Verbindung nach dem Einschalten)
After=@MOONRAKER_DIENST@.service @DIENST@.service
Wants=@MOONRAKER_DIENST@.service

[Service]
Type=simple
User=@USER@
ExecStart=@PY@ @TOOLS@/k2_startwaechter.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
